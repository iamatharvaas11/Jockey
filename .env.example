# JOCKY Configuration
# Copy this file to .env and fill in the values.

# === REQUIRED ===

# Secret key for JWT token signing. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY

# === OPTIONAL ===

# Database URL (default: SQLite in project root)
# For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/jocky
DATABASE_URL=sqlite+aiosqlite:///./jocky.db

# JWT token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project name shown in API docs
PROJECT_NAME=JOCKY

# Directory for evidence/artifact file storage
STORAGE_DIR=./storage

# CORS allowed origins (comma-separated)
# For development: http://localhost:8000,http://localhost:3000
# For production: https://your-domain.com
CORS_ORIGINS=http://localhost:8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# === AGENT SETTINGS ===
# Central server URL for remote agents
AGENT_SERVER_URL=http://localhost:8000
# Agent poll interval in seconds
AGENT_POLL_INTERVAL=5
# Heartbeat timeout for marking agents offline in seconds
AGENT_HEARTBEAT_TIMEOUT=30

# === PRODUCTION SETTINGS ===
# Set to 'production' or 'development'
ENVIRONMENT=development
# Base API prefix
API_V1_STR=/api/v1

